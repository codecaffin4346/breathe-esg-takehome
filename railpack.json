{
  "$schema": "https://schema.railpack.com",
  "providers": ["node", "python"],
  "packages": {
    "node": "20",
    "python": "3.11"
  },
  "steps": {
    "build": {
      "commands": ["chmod +x ./build.sh", "./build.sh"]
    }
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn backend.wsgi:application --bind 0.0.0.0:$PORT"
  }
}
